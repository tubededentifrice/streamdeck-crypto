{
  "name": "streamdeck-crypto",
  "version": "2.1.2",
  "description": "StreamDeck Crypto ticker plugin",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jsep": "^1.4.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "build:watch": "concurrently -k --names \"tsc,bundle\" \"tsc -p tsconfig.json --watch --preserveWatchOutput\" \"node esbuild.config.mjs --watch\"",
    "bundle": "node esbuild.config.mjs --mode=production",
    "bundle:watch": "node esbuild.config.mjs --watch",
    "test": "jest",
    "preview": "concurrently -k --names \"tsc,preview\" \"npm:build:watch\" \"npm:preview:serve\"",
    "preview:serve": "node preview-server.js",
    "watch": "concurrently -k --names \"tsc,streamdeck\" \"npm:build:watch\" \"node scripts/watch-streamdeck.js\"",
    "pretest": "npm run build",
    "lint": "eslint \"com.courcelle.cryptoticker-dev.sdPlugin/**/*.ts\" \"__tests__/**/*.{js,ts}\" preview-server.js scripts/watch-streamdeck.js eslint.config.js",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"**/*.{ts,js,json,css,html}\"",
    "prepare": "husky",
    "release:patch": "node scripts/release.js patch",
    "release:minor": "node scripts/release.js minor",
    "release:major": "node scripts/release.js major"
  },
  "lint-staged": {
    "**/*.{ts,js}": [
      "eslint --max-warnings=0 --fix",
      "prettier --write"
    ],
    "**/*.{json,css,html}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
